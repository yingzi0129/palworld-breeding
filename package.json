{
  "name": "palworld-breeding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-sitemap.js",
    "build:pages": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "data:build": "npx ts-node --skipProject scripts/build-data.ts",
    "data:seed": "wrangler d1 execute palworld-breeding-db --file=./scripts/seed-d1.sql"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@react-leaflet/core": "^2.1.0",
    "leaflet": "^1.9.4",
    "next": "14.2.35",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "^4.113.0"
  }
}
